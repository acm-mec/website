# Copy this file to .env. Never expose either value with a VITE_ prefix.
# Generate values with: node scripts/gen_pass.mjs "your admin password"
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Optional: ImgBB API Key for team member image uploads via Admin panel
# Get your free key at https://api.imgbb.com/
VITE_IMGBB_API_KEY=

